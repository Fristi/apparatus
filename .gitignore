.idea
### Scala template
*.class
*.log

# sbt specific
.cache
.history
.lib/
dist/*
target/
lib_managed/
src_managed/
project/boot/
project/plugins/project/
docs/**/*.md

# Scala-IDE specific
.scala_dependencies
.worksheet
/.bsp/
.metals/
.bloop/

# Metals writes these with a dynamic MCP port per session
.mcp.json
.vscode/mcp.json
.cursor/mcp.json

# cellar: keep the committed telemetry opt-out, ignore the local classpath cache
.cellar/*
!.cellar/cellar.conf
!.cellar/.telemetry-seen

# Node / VitePress
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# mdoc output (regenerated by sbt docs/mdoc)
docs/*.md
