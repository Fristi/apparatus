{
  "name": "apparatus",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20",
      "nodeGypDependencies": false
    }
  },
  "containerEnv": {
    "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal"
  },
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "scalameta.metals",
        "scala-lang.scala"
      ],
      "settings": {
        "metals.javaHome": "/usr/lib/jvm/msopenjdk-current",
        "metals.sbtScript": "/home/vscode/.local/share/coursier/bin/sbt",
        "metals.defaultBspToBuildTool": true,
        "metals.autoImportBuilds": "all",
        "metals.startMcpServer": true,
        "chat.mcp.enabled": true,
        "files.watcherExclude": {
          "**/target/**": true,
          "**/node_modules/**": true,
          "**/.metals/**": true,
          "**/.bloop/**": true
        }
      }
    }
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "VitePress",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-start.sh && bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "remoteUser": "vscode",
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=apparatus-coursier-cache,target=/home/vscode/.cache/coursier,type=volume",
    "source=apparatus-sbt-boot,target=/home/vscode/.sbt,type=volume",
    "source=apparatus-ivy2-cache,target=/home/vscode/.ivy2,type=volume"
  ]
}
